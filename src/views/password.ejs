<%- include('partials/top') %>
<div class="page-head">
  <div>
    <h1><%= user.must_change_password ? 'Choose your password' : 'Change password' %></h1>
    <% if (user.must_change_password) { %><p class="lede">You signed in with a temporary password. Choose your own before you continue.</p><% } %>
  </div>
</div>
<form method="post" action="/account/password" class="form" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
  <input type="text" name="username" value="<%= user.college_id %>" autocomplete="username" hidden>
  <div class="form-grid">
    <%- include('partials/input', { name: 'current_password', label: user.must_change_password ? 'Temporary password' : 'Current password', type: 'password', values: {}, errors, autocomplete: 'current-password', maxlength: 200, wide: true }) %>
    <%- include('partials/input', { name: 'new_password', label: 'New password', type: 'password', values: {}, errors, autocomplete: 'new-password', maxlength: 128, hint: 'At least 10 characters. A short sentence you can remember works well. Do not use your name or college ID.' }) %>
    <%- include('partials/input', { name: 'confirm_password', label: 'New password again', type: 'password', values: {}, errors, autocomplete: 'new-password', maxlength: 128 }) %>
  </div>
  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Save password</button>
    <% if (!user.must_change_password) { %><a class="btn" href="/account">Cancel</a><% } %>
  </div>
</form>
<%- include('partials/bottom') %>
