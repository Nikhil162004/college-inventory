<%- include('../partials/top') %>
<div class="page-head">
  <div>
    <p class="crumb"><a href="/users">People</a></p>
    <h1><%= heading %></h1>
  </div>
  <div class="actions">
    <% if (rows.length > 1) { %><button type="button" class="btn" data-save-csv="credentials" hidden>Save as CSV</button><% } %>
    <button type="button" class="btn" data-print hidden>Print</button>
    <a class="btn btn-primary no-print" href="/users">Done</a>
  </div>
</div>
<% if (rows.length) { %>
<div class="notice notice-warn no-print">
  <h2>These temporary passwords are shown only once</h2>
  <p>They are not stored in readable form and cannot be displayed again. Save or print this page now, and hand each password to its owner in person. Everyone must choose their own password at first sign-in.</p>
</div>
<table class="register credentials" id="credentials">
  <thead><tr><th>College ID</th><th>Name</th><th>Temporary password</th></tr></thead>
  <tbody>
  <% for (const r of rows) { %>
    <tr><td class="mono"><%= r.college_id %></td><td><%= r.name %></td><td class="mono"><%= r.password %></td></tr>
  <% } %>
  </tbody>
</table>
<% } else { %>
<p class="empty">No accounts were created.</p>
<% } %>
<% if (skipped.length) { %>
<section class="section no-print">
  <div class="section-head"><h2><%= skipped.length %> row<%= skipped.length === 1 ? '' : 's' %> skipped</h2></div>
  <table class="register">
    <thead><tr><th>Line</th><th>College ID</th><th>Reason</th></tr></thead>
    <tbody>
    <% for (const s of skipped) { %>
      <tr><td><%= s.line %></td><td class="mono"><%= s.college_id || '—' %></td><td><%= s.reason %></td></tr>
    <% } %>
    </tbody>
  </table>
</section>
<% } %>
<%- include('../partials/bottom') %>
