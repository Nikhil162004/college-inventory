<%- include('../partials/top') %>
<div class="page-head">
  <div>
    <p class="crumb"><a href="/users">People</a></p>
    <h1>Import roster</h1>
    <p class="lede">Create many student, faculty or staff accounts at once from a spreadsheet saved as CSV. Up to <%= fmt.number(maxRows) %> people per import.</p>
  </div>
</div>
<% if (error) { %><div class="notice notice-error" role="alert"><%= error %></div><% } %>
<form method="post" action="/users/import" class="form" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
  <div class="field">
    <label for="file">Choose a CSV file</label>
    <input id="file" type="file" accept=".csv,text/csv" data-csv-file>
    <p class="hint">The file is read in your browser and placed in the box below. Or paste the rows directly.</p>
  </div>
  <div class="field form-part">
    <label for="csv">Roster</label>
    <textarea id="csv" name="csv" rows="12" class="mono" spellcheck="false" data-csv-target required placeholder="college_id,name,role,department,email&#10;23CS001,Aarav Deshmukh,student,CSE,&#10;FAC014,Dr. Meera Kulkarni,faculty,ECE,meera@college.example"><%= csv %></textarea>
    <p class="hint">First row must be the header. Required columns: <span class="mono">college_id, name, role</span>. Optional: <span class="mono">department, email</span>. Role is <span class="mono">student</span>, <span class="mono">faculty</span> or <span class="mono">staff</span>. People who already have an account are skipped.</p>
  </div>
  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Import</button>
    <a class="btn" href="/users">Cancel</a>
  </div>
</form>
<%- include('../partials/bottom') %>
