# Copy this file to ".env" and fill it in. Never commit the real .env file.

# --- Required in production ---------------------------------------------------
NODE_ENV=production
# 32+ random characters. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# The public https address of this site. It is printed inside every QR label,
# so decide it BEFORE printing labels and do not change it afterwards.
BASE_URL=https://inventory.yourcollege.ac.in
# Number of reverse proxies (nginx, Caddy, load balancer) in front of the app. Usually 1.
TRUST_PROXY=1

# For a public demonstration only (see render.yaml): allows the made-up demo data,
# whose sign-ins are printed on the sign-in page, to be served in production.
# Leave it out on the real site.
# PUBLIC_DEMO=1

# --- Optional -------------------------------------------------------------------
COLLEGE_NAME=Your College Name
PORT=3000
HOST=127.0.0.1
DB_PATH=./data/inventory.db
TIMEZONE=Asia/Kolkata

# Signed out after this long without activity / after this long regardless.
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=12
# Wrong passwords before an account is locked, and for how long.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Failed sign-ins allowed per network address per 15 minutes.
LOGIN_RATE_LIMIT=30
# Problem reports one student or faculty member may file per hour.
REPORTS_PER_HOUR=10

# Reporting from the QR label without an account (anyone who scans a label).
# 1 = on. 0 = scanning asks for a sign-in first.
GUEST_REPORTS=1
# Per network address; a campus Wi-Fi shares few addresses.
GUEST_REPORTS_PER_HOUR=30
# Open reports from visitors on one item at a time.
GUEST_REPORTS_PER_ITEM=3

# --- Email alerts for new reports (optional) ------------------------------------
# Easiest: run "npm run alerts", which asks the questions, fills these in and
# sends a test. Leave ALERT_EMAIL out to keep alerts off.
# The address is used only to send mail; no page of the site ever shows it.
# ALERT_EMAIL=incharge@yourcollege.ac.in
# SMTP_HOST=smtp.yourcollege.ac.in
# 465 (encrypted from the start) or 587 (STARTTLS).
# SMTP_PORT=465
# SMTP_USER=register@yourcollege.ac.in
# For Gmail this is a 16-letter "app password", not the normal password.
# SMTP_PASS=
# At most this many alert emails an hour; further reports are saved, not emailed.
# ALERTS_PER_HOUR=60
